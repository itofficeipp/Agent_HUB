# Sinh bởi openclaw-kit (module n8n, tenant {{TENANT}}). Kit KHÔNG chạy file này; bạn chạy: docker compose up -d
# TRƯỚC KHI DÙNG THẬT: thay :latest bằng phiên bản n8n cụ thể (https://github.com/n8n-io/n8n/releases) để cập nhật có kiểm soát.
services:
  n8n:
    image: docker.n8n.io/n8nio/n8n:latest
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{N8N_PORT}}:5678"   # chỉ loopback; ra Internet qua tunnel/Caddy (xem HUONG_DAN.md)
    environment:
      - N8N_HOST={{N8N_PUBLIC_HOST}}
      - N8N_PORT=5678
      - N8N_PROTOCOL={{N8N_PROTOCOL}}
      - WEBHOOK_URL={{N8N_PUBLIC_URL}}/
      - N8N_SECURE_COOKIE={{N8N_SECURE_COOKIE}}
      - N8N_PROXY_HOPS=1
      - GENERIC_TIMEZONE={{TIMEZONE}}
      - TZ={{TIMEZONE}}
      - N8N_ENCRYPTION_KEY=${N8N_ENCRYPTION_KEY}
    volumes:
      - n8n_data:/home/node/.n8n
volumes:
  n8n_data:
