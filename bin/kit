#!/usr/bin/env python3
"""kit - bộ triển khai OpenClaw nhiều nơi (đa tenant, chỉ Python stdlib).

  kit setup [tenant]             CÀI TỪNG BƯỚC có gợi ý: kiểm tra máy, hỏi thông số, dựng, kiểm tra, nói bước tiếp
  kit preflight                  chỉ kiểm tra môi trường máy (OpenClaw, Docker, systemd...)
  kit init <tenant>              tạo tenant (công ty/máy) mới
  kit modules                    liệt kê chức năng, trạng thái, bản mới
  kit enable <module>            hỏi tham số, lưu (bí mật -> secrets.env chmod 600)
  kit apply [module] [--dry-run] dựng cấu hình/dịch vụ từ mẫu (idempotent)
  kit update [--with-openclaw]   git pull kit + (tuỳ chọn) update OpenClaw + migrations + apply + doctor
  kit doctor [--strict]          kiểm tra môi trường và từng module (gồm sandbox/runtime model); --strict: thoát mã 1 nếu có LỖI
  kit alert-bot                  nhập/đổi token bot Telegram + ID người nhận (nhập ẩn), gửi thử 1 tin, gắn luôn làm bot chat của agent tổng
  kit alert-test                 gửi thử 1 tin báo lỗi bằng cấu hình đang lưu
  kit alert-bind                 gắn (lại) bot đó làm bot chat của agent tổng (agent mặc định), chỉ ID nhận được nhắn
  kit model-backup [--agent A]   thêm tài khoản Claude DỰ PHÒNG (token nhập ẩn): tài khoản 1 hết lượt thì tự chuyển qua tài khoản 2; tự dừng/bật lại Gateway, đặt thứ tự
  kit sandbox-image [--force]    dựng image Docker sandbox cho agent (OpenClaw không tự dựng)
  kit run <module> <lệnh> ...    lệnh riêng của module (vd agent-web add-caller)
  kit export-config              xuất cấu hình máy hiện tại đã che bí mật (để xem/đưa vào mẫu)
"""
import argparse, datetime, getpass, time, json, os, re, secrets, shutil, stat, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
USER_HOME = Path(os.environ.get("KIT_USER_HOME", str(Path.home())))
CFG = Path(os.environ.get("KIT_HOME", str(USER_HOME / ".config" / "openclaw-kit")))
OC = os.environ.get("OPENCLAW_BIN", "openclaw")
VERSION = (ROOT / "VERSION").read_text().strip()

def die(msg, rc=1):
    print("LOI:", msg, file=sys.stderr); sys.exit(rc)

def now(): return datetime.datetime.now().strftime("%Y%m%d-%H%M%S")

# ---------- tenant / params ----------
def tenants_dir(): return CFG / "tenants"
def current_tenant(arg):
    if arg: return arg
    f = CFG / "current"
    if f.exists(): return f.read_text().strip()
    ts = sorted(p.name for p in tenants_dir().glob("*")) if tenants_dir().exists() else []
    if len(ts) == 1: return ts[0]
    die("chưa chọn tenant: dùng --tenant NAME hoặc 'kit init NAME'")
def tdir(t): return tenants_dir() / t
def set_current(t, force=False):
    """Đặt tenant mặc định. Chỉ ghi khi chưa có tenant mặc định (hoặc force): tạo/cấu hình tenant thứ hai KHÔNG đổi tenant đang dùng."""
    f = CFG / "current"
    if force or not f.exists() or not f.read_text().strip() or not tdir(f.read_text().strip()).exists():
        CFG.mkdir(parents=True, exist_ok=True); f.write_text(t + "\n"); return True
    return f.read_text().strip() == t
def read_json(p, default):
    return json.loads(Path(p).read_text()) if Path(p).exists() else default
def write_private(p, text):
    p = Path(p); p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(p.suffix + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f: f.write(text)
    os.replace(tmp, p)
def load_secrets(t):
    d = {}; p = tdir(t) / "secrets.env"
    if p.exists():
        for l in p.read_text().splitlines():
            if "=" in l and not l.lstrip().startswith("#"):
                k, v = l.split("=", 1); d[k.strip()] = v.strip()
    return d
def save_secrets(t, d):
    write_private(tdir(t) / "secrets.env", "".join(f"{k}={v}\n" for k, v in sorted(d.items())))
def load_params(t): return read_json(tdir(t) / "params.json", {})
def save_params(t, d):
    p = tdir(t) / "params.json"; p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(d, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
def load_state(t): return read_json(tdir(t) / "state.json", {"enabled": [], "applied": {}, "migrations": []})
def save_state(t, s): (tdir(t) / "state.json").write_text(json.dumps(s, indent=2, sort_keys=True) + "\n")

# ---------- modules ----------
def module_names():
    return sorted(p.name for p in (ROOT / "modules").iterdir() if (p / "module.json").exists())
def manifest(name):
    p = ROOT / "modules" / name / "module.json"
    if not p.exists(): die(f"không có module '{name}' (xem: kit modules)")
    return json.loads(p.read_text())
def with_deps(names, seen=None):
    out = []
    def visit(n):
        if n in out: return
        for d in manifest(n).get("requires", []): visit(d)
        out.append(n)
    for n in names: visit(n)
    return out

def default_value(spec):
    d = spec.get("default", "")
    if isinstance(d, str) and d.startswith("random:hex"):
        return secrets.token_hex(int(d[10:] or 4))
    if isinstance(d, str) and d.startswith("random:token"):
        return secrets.token_urlsafe(int(d[12:] or 24))
    return d

def cond_ok(item, get):
    """item có thể mang 'when': {KEY: giá trị | [giá trị...]}; chỉ áp dụng khi mọi điều kiện đúng."""
    for k, want in (item.get("when") or {}).items():
        want = want if isinstance(want, list) else [want]
        cur = str(get(k) or "")
        if "*" in want and cur: continue   # "*" = có giá trị bất kỳ (không trống)
        if cur not in [str(w) for w in want]: return False
    return True

def probe_healthz(url):
    """Kiểm nhanh <url>/healthz (n8n trả ok). Chỉ cảnh báo, không chặn: máy có thể chưa bật n8n."""
    import urllib.request
    try:
        with urllib.request.urlopen(urllib.request.Request(url.rstrip("/") + "/healthz", headers={"User-Agent": "curl/8.5.0"}), timeout=8) as r:
            print(f"    OK {url}/healthz trả {r.status}")
    except Exception as e:
        print(f"    CẢNH BÁO: chưa gọi được {url}/healthz ({str(e)[:100]}). Kiểm DNS/tunnel/firewall; vẫn lưu tham số.")

def validate_param(spec, val):
    """Trả về thông báo lỗi tiếng Việt, hoặc '' nếu hợp lệ."""
    if val == "" and spec.get("required", True) and not spec.get("optional"):
        return "chưa nhập (bắt buộc)"
    pat = spec.get("pattern")
    if val != "" and pat and not re.fullmatch(pat, val):
        return "sai định dạng" + (f" (ví dụ đúng: {spec['example']})" if spec.get("example") else f" (cần khớp {pat})")
    return ""

def tg():
    """Nạp modules/agent-web/orchestrator/tgalert.py (gửi báo lỗi trực tiếp qua Telegram Bot API)."""
    d = str(ROOT / "modules" / "agent-web" / "orchestrator")
    if d not in sys.path: sys.path.insert(0, d)
    import tgalert; return tgalert

def probe_alert(token, target, interactive=True):
    """Kiểm token bằng getMe rồi gửi 1 tin thử tới target. Chỉ cảnh báo, không chặn (vẫn lưu tham số).
    Trả True nếu gửi được. Không bao giờ in token."""
    T = tg()
    for _ in range(3):
        ok, info = T.get_me(token)
        if not ok: print("    CẢNH BÁO: " + info); return False
        print(f"    OK token thuộc bot @{info}")
        ok, msg = T.send(token, target, f"✅ Thử báo lỗi từ kit {VERSION}: nếu đọc được tin này thì khi hệ thống lỗi sẽ có tin báo ở đây.")
        if ok: print(f"    OK đã gửi tin thử tới ID {target}: mở Telegram xem có tin từ @{info}"); return True
        print("    CẢNH BÁO: " + msg)
        if not interactive or ("Start" not in msg and "không thấy ID" not in msg): return False
        r = input("    Sau khi bấm Start với bot: Enter = thử lại, gõ 'bo' = bỏ qua: ").strip().lower()
        if r in ("bo", "bỏ", "b", "n", "no"): return False
    return False

def oc_get(path):
    """Đọc 1 khoá cấu hình OpenClaw (JSON). Không có/lỗi -> None."""
    if not oc_available(): return None
    r = subprocess.run([OC, "config", "get", path], capture_output=True, text=True)
    if r.returncode != 0: return None
    txt = r.stdout.strip()
    for cand in (txt, txt[txt.find("{"):] if "{" in txt else "", txt[txt.find("["):] if "[" in txt else ""):
        try: return json.loads(cand)
        except Exception: pass
    return None

def default_agent_id():
    """ID agent mặc định (agent tổng). Không đọc được thì dùng 'main'."""
    if oc_available():
        r = subprocess.run([OC, "agents", "list", "--json"], capture_output=True, text=True)
        try:
            d = json.loads(r.stdout[r.stdout.find("["):] if "[" in r.stdout and (r.stdout.find("{") < 0 or r.stdout.find("[") < r.stdout.find("{")) else r.stdout[r.stdout.find("{"):])
            lst = d if isinstance(d, list) else (d.get("agents") or [])
            for e in lst:
                if isinstance(e, dict) and (e.get("isDefault") or e.get("default")) and e.get("id"): return str(e["id"])
            ids = [str(e["id"]) for e in lst if isinstance(e, dict) and e.get("id")]
            if "main" in ids or not ids: return "main"
            return ids[0]
        except Exception: pass
    return "main"

def bind_main_bot(t, token, target, name="", interactive=True):
    """Dùng chính token bot này làm bot chat của AGENT TỔNG (agent mặc định) trên Gateway:
    channels.telegram.tokenFile (file chmod 600), chỉ ID người nhận được nhắn (allowlist) và là chủ sở hữu
    (commands.ownerAllowFrom), gắn account telegram:default vào agent mặc định, đặt tên hiển thị = tên trợ lý.
    Idempotent. Trả True nếu xong, False nếu bỏ qua/lỗi (in lý do)."""
    if not re.fullmatch(r"[0-9]{5,15}", str(target or "")):
        print("   (Bỏ qua gắn bot vào agent: ID nhận là ID nhóm/không hợp lệ; chỉ ID người dùng (dãy số dương) mới được làm chủ bot chat.)"); return False
    if not oc_available():
        print("   (Bỏ qua gắn bot vào agent: chưa thấy openclaw trong PATH. Sau khi cài OpenClaw chạy: kit alert-bind)"); return False
    if not os.environ.get("KIT_NO_PROBE"):
        okt, info = tg().get_me(token)
        if not okt: print("   (Bỏ qua gắn bot vào agent: Telegram không nhận token này: " + info + ". Sửa token rồi chạy: kit alert-bot)"); return False
    tf = tdir(t) / "telegram-main.token"
    cur = oc_get("channels.telegram")
    cur = cur if isinstance(cur, dict) else {}
    other = cur.get("tokenFile") and str(cur["tokenFile"]) != str(tf)
    if cur.get("botToken") or other:
        same = False
        if other and not cur.get("botToken"):
            try: same = Path(cur["tokenFile"]).read_text().strip() == token
            except Exception: same = False
        if not same:
            print("   Kênh Telegram của OpenClaw đang dùng MỘT BOT KHÁC (channels.telegram đã có token).")
            if not (interactive and yesno("   Thay bằng bot này làm bot chat của agent tổng? (bot cũ sẽ ngừng nhận tin)", False, interactive)):
                print("   Giữ nguyên bot cũ, KHÔNG gắn. Muốn đổi sau: kit alert-bind"); return False
    write_private(tf, token)
    allow = [str(x) for x in (cur.get("allowFrom") or []) if str(x) != str(target)] + [str(target)]
    owners = oc_get("commands.ownerAllowFrom"); owners = [str(x) for x in owners] if isinstance(owners, list) else []
    if f"telegram:{target}" not in owners: owners.append(f"telegram:{target}")
    tgp = {"enabled": True, "tokenFile": str(tf), "allowFrom": allow,
           "dmPolicy": cur.get("dmPolicy") if cur.get("dmPolicy") in ("allowlist", "disabled") else "allowlist"}
    if not cur.get("groupPolicy"): tgp["groupPolicy"] = "disabled"
    bk = backup_openclaw_config()
    if bk: print(f"   Đã sao lưu cấu hình OpenClaw: {bk}")
    if not oc_patch(json.dumps({"channels": {"telegram": tgp}, "commands": {"ownerAllowFrom": owners}}), False):
        print("   CHƯA ghi được cấu hình Telegram cho agent tổng (xem lỗi ở trên)."); return False
    aid = default_agent_id()
    r = run([OC, "agents", "bind", "--agent", aid, "--bind", "telegram:default"])
    if r.returncode != 0 and "already" not in (r.stdout + r.stderr).lower():
        print(f"   CẢNH BÁO: chưa gắn được bot vào agent '{aid}': {(r.stderr or r.stdout).strip()[:300]}"); return False
    if name:
        r = run([OC, "agents", "set-identity", "--agent", aid, "--name", name])
        if r.returncode != 0: print(f"   CẢNH BÁO: chưa đặt được tên hiển thị '{name}' cho agent '{aid}': {(r.stderr or r.stdout).strip()[:300]}")
    print(f"   OK bot này nay là bot chat của agent tổng '{aid}'" + (f" ({name})" if name else "") + f"; chỉ ID {target} được nhắn và là chủ sở hữu.")
    print("      Cấu hình áp dụng khi Gateway rảnh (không cần restart). Kiểm: timeout 50 openclaw channels status --probe --json")
    return True

def collect_params(t, mods, sets, interactive):
    params, sec = load_params(t), load_secrets(t)
    getv = lambda k: sets.get(k, params.get(k, sec.get(k)))
    for m in mods:
        for spec in manifest(m).get("params", []):
            k = spec["key"]; is_sec = spec.get("secret", False)
            have = sec if is_sec else params
            if not cond_ok(spec, getv): continue
            dv0 = default_value(spec); dis = spec.get("default_if_set")
            if dis and getv(dis["key"]): dv0 = dis["value"]   # tenant cũ: đã có khoá này thì giữ hành vi cũ
            if k in sets: val = sets[k]
            elif k in have and have[k] != "": continue
            elif os.environ.get("KIT_" + k): val = os.environ["KIT_" + k]
            elif interactive:
                dv = dv0
                print(f"\n[{m}] {spec['prompt']}")
                if spec.get("hint"): print("   gợi ý: " + spec["hint"])
                if spec.get("example"): print("   ví dụ: " + spec["example"])
                for _ in range(5):
                    ptxt = "   > " + (f"[{'ẩn' if is_sec else dv}] " if (dv or is_sec) else "")
                    val = (getpass.getpass(ptxt) if is_sec else input(ptxt)).strip() or dv
                    err = validate_param(spec, val)
                    if not err: break
                    print("   ! " + err + "; nhập lại")
                else: die(f"{k}: nhập sai 5 lần")
            else: val = dv0
            err = validate_param(spec, val)
            if err: die(f"{k}: {err}; dùng --set {k}=... hoặc chạy tương tác")
            (sec if is_sec else params)[k] = val
            if val and spec.get("probe") == "healthz" and interactive and not os.environ.get("KIT_NO_PROBE"): probe_healthz(val)
            if k == "AW_ALERT_BOT_TOKEN" and val and interactive and not os.environ.get("KIT_NO_PROBE"): probe_alert(val, getv("AW_ALERT_TARGET"), True)
            if k == "AW_ALERT_BOT_TOKEN" and val and interactive and not os.environ.get("KIT_NO_BIND") and yesno("\n   Dùng luôn bot này làm bot CHAT của agent tổng (agent mặc định); chỉ ID nhận ở trên được nhắn và là chủ sở hữu?", True, interactive): bind_main_bot(t, val, getv("AW_ALERT_TARGET"), getv("ASSISTANT_NAME") or "", True)
    save_params(t, params); save_secrets(t, sec)
    return params, sec

def context(t):
    c = {"HOME": str(USER_HOME), "KIT_ROOT": str(ROOT), "TENANT": t, "TENANT_DIR": str(tdir(t)),
         "OPENCLAW_BIN": OC, "KIT_VERSION": VERSION, "KIT_HOME_DIR": str(CFG)}
    c.update(load_params(t)); c.update(load_secrets(t))
    from urllib.parse import urlparse
    for k, host_k in (("AW_PUBLIC_URL", "AW_PUBLIC_HOST"), ("N8N_PUBLIC_URL", "N8N_PUBLIC_HOST")):
        if c.get(k): c[host_k] = urlparse(c[k]).hostname or ""
    if c.get("N8N_PUBLIC_URL"):
        https = urlparse(c["N8N_PUBLIC_URL"]).scheme == "https"
        c["N8N_PROTOCOL"] = "https" if https else "http"; c["N8N_SECURE_COOKIE"] = "true" if https else "false"
    return c

def render(text, ctx, where=""):
    def sub(m):
        k = m.group(1)
        if k not in ctx: die(f"mẫu {where} dùng {{{{{k}}}}} nhưng chưa có tham số (chạy 'kit enable')")
        return str(ctx[k])
    return re.sub(r"\{\{([A-Z0-9_]+)\}\}", sub, text)

# ---------- openclaw helpers ----------
def oc_available(): return shutil.which(OC) is not None
def oc_patch(patch_text, dry):
    if not oc_available():
        print("  ! không thấy openclaw trong PATH — bỏ qua config patch (chạy lại sau khi cài OpenClaw)"); return True
    args = [OC, "config", "patch", "--stdin"] + (["--dry-run"] if dry else [])
    r = subprocess.run(args, input=patch_text, capture_output=True, text=True)
    if r.returncode != 0: print(r.stdout + r.stderr); return False
    return True
def backup_openclaw_config():
    src = USER_HOME / ".openclaw" / "openclaw.json"
    if src.exists():
        dst = CFG / "backups" / f"openclaw.json.{now()}"; dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst); os.chmod(dst, 0o600); return dst

# ---------- apply ----------
def apply_module(t, name, ctx, dry):
    man = manifest(name); mdir = ROOT / "modules" / name
    print(f"== {name} v{man['version']}" + (" (dry-run)" if dry else ""))
    stamp = now(); bk = CFG / "backups" / f"files.{stamp}"
    for f in man.get("files", []):
        if not cond_ok(f, ctx.get): continue
        src = mdir / render(f["src"], ctx, f["src"]); dest = Path(render(f["dest"], ctx, f["dest"])).expanduser()
        if not src.exists(): die(f"module {name}: thiếu file nguồn {src.relative_to(ROOT)}")
        txt = src.read_text()
        if f.get("render", True): txt = render(txt, ctx, f["src"])
        mode = int(f.get("mode", "0644"), 8); policy = f.get("if_exists", "replace")
        if dest.exists():
            if dest.read_text() == txt: print(f"  = {dest} (không đổi)"); continue
            if policy == "skip": print(f"  - {dest} đã có, giữ nguyên"); continue
            if policy == "sidecar":
                dest2 = dest.with_name(dest.name + ".kit-new"); print(f"  ~ {dest} đã có -> ghi bản mới ở {dest2.name}")
                dest = dest2
        print(f"  + {dest}")
        if dry: continue
        if dest.exists():
            b = bk / dest.name; b.parent.mkdir(parents=True, exist_ok=True); shutil.copy2(dest, b)
        dest.parent.mkdir(parents=True, exist_ok=True)
        if mode & 0o077 == 0: write_private(dest, txt)
        else: dest.write_text(txt)
        os.chmod(dest, mode)
    if "config_patch" in man:
        patch = render((mdir / man["config_patch"]).read_text(), ctx, man["config_patch"])
        try: json.loads(patch)
        except ValueError as e: die(f"config_patch của {name} không phải JSON hợp lệ sau khi render: {e}")
        print("  ~ openclaw config patch (kiểm schema trước)")
        if not oc_patch(patch, True): die(f"OpenClaw từ chối config patch của {name} (schema đổi? xem docs/UPDATING.md)")
        if not dry:
            b = backup_openclaw_config()
            if b: print(f"    sao lưu config -> {b}")
            if not oc_patch(patch, False): die(f"ghi config patch của {name} thất bại")
    for cmd in man.get("post_apply", []):
        if isinstance(cmd, dict):
            if not cond_ok(cmd, ctx.get): continue
            cmd = cmd["argv"]
        argv = [render(a, ctx, "post_apply") for a in cmd]
        print("  $ " + " ".join(argv) + ("  (bỏ qua: dry-run)" if dry else ""))
        if not dry:
            r = subprocess.run(argv, env=dict(os.environ, KIT_TENANT=t, KIT_HOME=str(CFG), KIT_ROOT=str(ROOT)))
            if r.returncode != 0: die(f"post_apply thất bại rc={r.returncode}: {argv[0]}")
    return man["version"]

# ---------- preflight / setup ----------
def preflight(mods=()):
    """In kết quả kiểm tra máy; trả về số mục LỖI (cảnh báo không tính)."""
    bad = 0
    def chk(level, ok, msg, hint=""):
        nonlocal bad
        tag = "OK       " if ok else ("LOI      " if level == "err" else "CANH BAO ")
        print("  " + tag + msg + ("" if ok else f"\n           -> {hint}"))
        if not ok and level == "err": bad += 1
    chk("err", os.getuid() != 0, "đang chạy bằng user thường", "đừng dùng root; tạo user riêng (vd: sudo adduser openclaw) rồi đăng nhập lại")
    chk("err", sys.version_info >= (3, 9), f"python {sys.version.split()[0]}", "cần >= 3.9")
    chk("err", bool(shutil.which("git")), "git", "sudo apt install -y git")
    if oc_available(): chk("err", True, "openclaw " + (run([OC, "--version"]).stdout.strip() or "?"))
    else: chk("err", False, "openclaw", "cài: curl -fsSL https://openclaw.ai/install.sh | bash, rồi: openclaw onboard --install-daemon")
    chk("warn", bool(shutil.which("node")), "node", "trình cài OpenClaw thường tự cài Node; nếu thiếu xem docs OpenClaw")
    sysd = Path("/run/systemd/system").exists() and bool(shutil.which("systemctl"))
    chk("warn", sysd, "systemd (dịch vụ nền)", "máy không dùng systemd: dịch vụ nền (receiver, timer) phải tự chạy; thử trong Docker/WSL sẽ thiếu mục này")
    if sysd and shutil.which("loginctl"):
        lg = run(["loginctl", "show-user", os.environ.get("USER") or str(os.getuid()), "-p", "Linger"]).stdout
        chk("warn", "yes" in lg, "dịch vụ user chạy nền khi không đăng nhập (linger)", "sudo loginctl enable-linger $USER")
    if set(mods) & {"agent-web", "n8n"}:
        dk = bool(shutil.which("docker"))
        chk("warn", dk, "docker (agent chạy trong sandbox; n8n cũng cần)", "cài Docker Engine theo docs.docker.com/engine/install/ubuntu rồi: sudo usermod -aG docker $USER (đăng nhập lại)")
        if dk: chk("warn", run(["docker", "info"]).returncode == 0, "user hiện tại dùng được docker (không cần sudo)", "sudo usermod -aG docker $USER rồi đăng nhập lại")
    free = shutil.disk_usage(str(USER_HOME)).free / 2**30
    cfgp = CFG.parent
    for d in (cfgp, cfgp / "systemd" / "user"):
        if d.exists(): chk("err", not (d.stat().st_mode & 0o022), f"quyền thư mục {d} (không nhóm/người khác ghi được)", f"chmod go-w {d}   (OpenClaw từ chối cài service nếu thư mục này group/world-writable)")
    chk("warn", free >= 5, f"dung lượng trống {free:.1f} GB (khuyên >= 5 GB; image sandbox khá nặng)", "giải phóng ổ đĩa hoặc mở rộng đĩa")
    print("  => " + ("sẵn sàng" if not bad else f"{bad} mục LỖI cần sửa trước khi cài"))
    return bad

def cmd_preflight(a):
    t = a.tenant or ((CFG / "current").read_text().strip() if (CFG / "current").exists() else None)
    st = load_state(t) if t and tdir(t).exists() else {"enabled": []}
    sys.exit(1 if preflight(st["enabled"] or ["agent-web"]) else 0)

def yesno(q, default=True, interactive=True):
    if not interactive: return default
    while True:
        r = input(f"{q} [{'Y/n' if default else 'y/N'}]: ").strip().lower()
        if not r: return default
        if r in ("y", "yes", "c", "co", "có"): return True
        if r in ("n", "no", "k", "khong", "không"): return False

def kit_cmd(t, *args):
    return subprocess.run([sys.executable, str(Path(__file__).resolve()), "--tenant", t, *args]).returncode

def cmd_setup(a):
    inter = not a.yes and sys.stdin.isatty()
    print(f"== kit {VERSION}: cài đặt từng bước. Chạy lại bất cứ lúc nào an toàn (giá trị đã nhập được giữ; muốn đổi: kit enable <module> --set KEY=giá_trị).")
    print("\n[1/5] Kiểm tra máy")
    bad = preflight(["agent-web"])
    if bad and not yesno("   Còn mục LỖI. Vẫn tiếp tục?", False, inter):
        die("dừng: sửa các mục LỖI ở trên rồi chạy lại 'kit setup'" if inter else "preflight có LỖI")
    print("\n[2/5] Tên công ty/máy (tenant): mỗi công ty một tenant riêng, tham số và bí mật tách biệt")
    existing = sorted(p.name for p in tenants_dir().glob("*")) if tenants_dir().exists() else []
    t = a.name or a.tenant
    if not t:
        if inter:
            if existing: print("   đã có:", ", ".join(existing), "(nhập trùng tên = tiếp tục cấu hình tenant đó)")
            print("   gợi ý: a-z, 0-9, _ hoặc -, 2-31 ký tự. Ví dụ: congty-abc")
            for _ in range(5):
                t = input("   > ").strip()
                if re.fullmatch(r"[a-z0-9][a-z0-9_-]{1,30}", t): break
                print("   ! chỉ gồm a-z 0-9 _ - (2-31 ký tự); nhập lại")
            else: die("tên tenant sai 5 lần")
        elif len(existing) == 1: t = existing[0]
        else: die("cần tên tenant: kit setup <ten-cong-ty>")
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{1,30}", t): die("tên tenant: a-z 0-9 _ - (2-31 ký tự)")
    if not tdir(t).exists(): cmd_init(argparse.Namespace(name=t))
    else: set_current(t); print(f"   dùng tenant có sẵn '{t}'")
    st = load_state(t)
    print("\n[3/5] Chọn chức năng")
    names = module_names()
    if a.modules:
        chosen = [x.strip() for x in a.modules.split(",") if x.strip()]
        miss = [x for x in chosen if x not in names]
        if miss: die("module không có: " + ",".join(miss))
    else:
        chosen = []
        for n in names:
            m = manifest(n); dflt = n in ("base", "agent-web") or n in st["enabled"]
            print(f"   - {n}: {m['title']}")
            if n == "base" or yesno(f"     bật '{n}'?", dflt, inter): chosen.append(n)
    mods = with_deps(chosen)
    print("   sẽ bật:", ", ".join(mods))
    print("\n[4/5] Thông số của công ty (Enter = nhận giá trị trong [ ]; bí mật nhập ẩn, lưu chmod 600)")
    sets = dict(x.split("=", 1) for x in (a.set or []))
    if a.params_file:
        for k, v in json.loads(Path(a.params_file).read_text()).items():
            if not k.startswith("_"): sets.setdefault(k, str(v))
    params, sec = collect_params(t, mods, sets, interactive=inter)
    ctx_get = lambda k: params.get(k, sec.get(k))
    print("\n   Tóm tắt:")
    for m in mods:
        for spec in manifest(m).get("params", []):
            if not cond_ok(spec, ctx_get): continue
            k = spec["key"]; v = sec.get(k) if spec.get("secret") else params.get(k)
            print(f"     {k:<20} = " + ("(đã lưu, ẩn)" if spec.get("secret") and v else (v if v not in (None, "") else "(trống)")))
    if not yesno("   Đúng chưa? Lưu và dựng thử (chưa ghi gì, chỉ xem trước)", True, inter): die("đã dừng; chạy lại 'kit setup' để sửa (hoặc kit enable <module> --set KEY=...)")
    for m in mods:
        if m not in st["enabled"]: st["enabled"].append(m)
    save_state(t, st)
    print("\n[5/5] Dựng và kiểm tra")
    ns = argparse.Namespace(tenant=t, module=None, dry_run=True)
    cmd_apply(ns)
    if a.no_apply: print("\nĐã dừng trước khi dựng (--no-apply). Khi sẵn sàng: kit apply"); return
    if not yesno("\n   Xem trước ổn. Dựng thật (tự sao lưu openclaw.json trước)?", True, inter): print("Chưa dựng. Khi sẵn sàng: kit apply"); return
    ns.dry_run = False; cmd_apply(ns)
    if "agent-web" in mods and ctx_get("AW_BACKEND") == "local":
        if not (tdir(t) / "agent-web" / "gateway_pub.pem").exists() and yesno("\n   Tạo khoá mã hoá trên Gateway (kit run agent-web keygen)?", True, inter): kit_cmd(t, "run", "agent-web", "keygen")
        if inter and not (tdir(t) / "agent-web" / "users.json").exists() and yesno("\n   Tạo bên gọi webhook đầu tiên (hệ thống web/HRM gọi vào)? Mật khẩu ghi vào file riêng (không in ra màn hình)", True, inter):
            cn = input("   tên bên gọi (vd hrm) [web]: ").strip() or "web"
            kit_cmd(t, "run", "agent-web", "add-caller", cn)
    print("\n== Kiểm tra (kit doctor)")
    nbad = cmd_doctor(argparse.Namespace(tenant=t))
    print(f"""
== BƯỚC TIẾP
  1. {"Doctor còn mục LOI: thường là chưa tạo bên gọi hoặc chưa cấu hình tunnel/Caddy (đọc dòng '->' để biết cách sửa)." if nbad else "Doctor: tất cả OK."}
       kit run agent-web add-caller <ten>        thêm bên gọi (mật khẩu ghi vào file 600, không in)
       hướng dẫn đưa ra Internet: {tdir(t)}/agent-web/expose/HUONG_DAN.md
       thêm tài khoản Claude dự phòng (tuỳ chọn): kit model-backup (hết hạn mức tài khoản 1 thì tự chuyển tài khoản 2)
       báo lỗi về Telegram: kit alert-bot (nhập token bot + ID, gửi thử); kit alert-test (gửi thử lại)
  2. Bật dịch vụ nền khi sẵn sàng (nếu AW_AUTOSTART=no): xem dòng GỢI Ý ở phần dựng phía trên.
  3. Thử webhook đủ các ca: kit run agent-web test-webhook --user <ten> --password <mk> --secret <hmac_key>
  4. Cập nhật kit về sau: kit update""")

def _alert_cfg(t):
    c = context(t); return c.get("AW_ALERT_TARGET", ""), c.get("AW_ALERT_BOT_TOKEN", "")

def cmd_alert_bot(a):
    """Nhập/đổi bot báo lỗi. Token nhập ẩn (không đặt trên dòng lệnh, không hiện lên màn hình)."""
    t = current_tenant(a.tenant)
    if not tdir(t).exists(): die(f"chưa có tenant '{t}' (kit setup {t})")
    if not sys.stdin.isatty(): die("kit alert-bot cần chạy trong terminal (token nhập ẩn, không nhận qua tham số dòng lệnh)")
    params, sec = load_params(t), load_secrets(t)
    print(f"== Bot báo lỗi của tenant '{t}'\n   Bot gửi tin báo lỗi tới một ID Telegram (gọi thẳng Bot API, không qua Gateway).\n   Mặc định kit còn dùng luôn token này làm bot CHAT của agent tổng; chỉ ID nhận được nhắn và là chủ sở hữu. Không muốn: kit alert-bot --no-chat")
    print("   1) Tạo bot: nhắn @BotFather, gõ /newbot, nhận token.  2) Mở bot đó trong Telegram, bấm Start.  3) ID của bạn: nhắn @userinfobot.")
    cur = params.get("AW_ALERT_TARGET", "")
    for _ in range(5):
        v = input(f"\n   ID Telegram người nhận (một dãy số){' [' + cur + ']' if cur else ''} > ").strip() or cur
        if re.fullmatch(r"-?[0-9]{5,15}", v): break
        print("   ! ID phải là một dãy số (vd 123456789); nhập lại")
    else: die("ID nhập sai 5 lần")
    token = sec.get("AW_ALERT_BOT_TOKEN", "")
    for _ in range(5):
        v2 = getpass.getpass("   Token bot (nhập ẩn" + ("; Enter = giữ token đang lưu" if token else "") + ") > ").strip() or token
        if re.fullmatch(r"[0-9]{6,12}:[A-Za-z0-9_-]{30,60}", v2): break
        print("   ! token có dạng 123456789:AA... do @BotFather cấp; nhập lại")
    else: die("token nhập sai 5 lần")
    params["AW_ALERT_TARGET"] = v; params.setdefault("AW_ALERT_CHANNEL", "telegram"); sec["AW_ALERT_BOT_TOKEN"] = v2
    save_params(t, params); save_secrets(t, sec)
    print("   Đã lưu (token trong secrets.env, chmod 600). Gửi thử:")
    ok = probe_alert(v2, v, interactive=True)
    print("   Kết quả: " + ("ĐÃ GỬI được tin thử." if ok else "CHƯA gửi được tin thử. Đã lưu cấu hình; sửa theo gợi ý ở trên rồi chạy: kit alert-test"))
    if not getattr(a, "no_chat", False):
        print("\n   Gắn bot vào agent tổng:"); bind_main_bot(t, v2, v, params.get("ASSISTANT_NAME", ""), True)
    sys.exit(0 if ok else 1)

def cmd_alert_bind(a):
    """Gắn (lại) bot báo lỗi đang lưu làm bot chat của agent tổng. Không hỏi token."""
    t = current_tenant(a.tenant); tgt, tok = _alert_cfg(t)
    if not tgt or not tok: die("chưa có ID/token bot báo lỗi. Chạy: kit alert-bot")
    params = load_params(t)
    sys.exit(0 if bind_main_bot(t, tok, tgt, params.get("ASSISTANT_NAME", ""), sys.stdin.isatty()) else 1)

# ---------- tài khoản model DỰ PHÒNG (kit model-backup) ----------
GW_UNIT = "openclaw-gateway"
def _gw_active():
    return bool(shutil.which("systemctl")) and run(["systemctl", "--user", "is-active", "--quiet", GW_UNIT]).returncode == 0
def _gw(action): return run(["systemctl", "--user", action, GW_UNIT])

def model_profiles(agent, provider="anthropic"):
    """Các profile đã lưu của nhà cung cấp (đọc 'openclaw models auth list', không in bí mật). Lỗi -> None."""
    r = run([OC, "models", "auth", "list", "--provider", provider, "--agent", agent], timeout=90)
    if r.returncode != 0: return None
    out = []
    for l in (r.stdout + "\n" + r.stderr).splitlines():
        m = re.match(r"\s*-\s+(" + re.escape(provider) + r":[^\s\[]+)", l)
        if m and m.group(1) not in out: out.append(m.group(1))
    return out

def model_order(agent, provider="anthropic"):
    """Thứ tự ưu tiên đang đặt (cần Gateway TẮT). Không đọc được/chưa đặt -> []."""
    r = run([OC, "models", "auth", "order", "get", "--provider", provider, "--agent", agent], timeout=90)
    if r.returncode != 0: return []
    out = []
    for l in r.stdout.splitlines():
        if "order" in l.lower(): out += re.findall(re.escape(provider) + r":[^\s,\[\]]+", l)
    return list(dict.fromkeys(out))

def cmd_model_backup(a):
    """Thêm tài khoản Claude DỰ PHÒNG cho agent tổng: tài khoản 1 hết lượt thì tự chuyển qua tài khoản 2."""
    if not oc_available(): die("chưa thấy openclaw trong PATH")
    if not sys.stdin.isatty(): die("kit model-backup cần chạy trong terminal (token nhập ẩn, không nhận qua tham số dòng lệnh)")
    prov = "anthropic"; agent = a.agent or default_agent_id()
    have = model_profiles(agent, prov)
    if have is None: die("không đọc được danh sách tài khoản của agent '" + agent + "' (openclaw models auth list lỗi)")
    pid = a.profile_id
    if not pid:
        pid = prov + ":manual" if not have else next(prov + ":tk" + str(n) for n in range(2, 99) if prov + ":tk" + str(n) not in have)
    if not re.fullmatch(prov + r":[A-Za-z0-9_.-]{1,40}", pid): die("--profile-id phải dạng " + prov + ":ten (chữ, số, _ . -)")
    print("== Tài khoản model dự phòng cho agent '" + agent + "'")
    print("   Đã lưu: " + (", ".join(have) if have else "(chưa có)") + ". Sẽ thêm: " + pid)
    if not have: print("   ! Chưa có tài khoản nào: token này sẽ là tài khoản CHÍNH (dùng docs/MODEL-AUTH.md để lấy token). Muốn thêm dự phòng sau khi có tài khoản chính: chạy lại lệnh này.")
    if pid in have and not yesno("   Profile " + pid + " đã có; GHI ĐÈ token cũ bằng token mới?", False, True):
        print("   Giữ nguyên, không đổi gì."); return
    print("   Cách lấy token: trên máy có trình duyệt, đăng nhập ĐÚNG tài khoản Claude số 2, chạy:  claude setup-token  (link in ra mở bằng trình duyệt, dán mã về). Token dạng sk-ant-oat01-... chỉ hiện một lần.")
    tok = ""
    for _ in range(5):
        v = re.sub(r"\s+", "", getpass.getpass("\n   Dán token (nhập ẩn; khoảng trắng/xuống dòng thừa được bỏ qua) > "))
        if re.fullmatch(r"sk-ant-oat01-[A-Za-z0-9_-]{20,}", v): tok = v; break
        print("   ! chuỗi vừa dán không phải token (phải bắt đầu bằng sk-ant-oat01-). Có thể dán nhầm mã xác nhận ở trình duyệt hoặc thiếu đoạn đầu/cuối; dán lại")
    if not tok: die("token nhập sai 5 lần")
    was = _gw_active()
    if not yesno("\n   Tạm dừng Gateway vài giây để ghi token (OpenClaw bắt buộc), xong tự bật lại. Tiếp tục?", True, True): print("   Đã hủy, chưa đổi gì."); return
    rc = 1
    try:
        if was:
            r = _gw("stop")
            if r.returncode != 0: die("không dừng được Gateway: " + (r.stderr or r.stdout).strip()[:300])
            print("   Gateway đã dừng.")
        feeder = str(ROOT / "scripts" / "pty_feed.py")
        for i in range(4):
            r = subprocess.run([sys.executable, feeder, "token", "--", OC, "models", "auth", "paste-token", "--provider", prov, "--agent", agent, "--profile-id", pid, "--expires-in", "365d"],
                               input=tok, capture_output=True, text=True, timeout=180)
            log = (r.stdout or "").replace(tok, "***")
            if pid in (model_profiles(agent, prov) or []): break
            if "offline state" in log and i < 3: time.sleep(float(os.environ.get("KIT_GW_WAIT", "3"))); continue
            print("   CHƯA lưu được token. Nhật ký (đã che token):\n" + "\n".join("     " + l for l in log.strip().splitlines()[-8:]))
            return
        after = model_profiles(agent, prov) or []
        cur = [x for x in model_order(agent, prov) if x in after]
        first = [x for x in after if x == prov + ":manual"] if not cur else []
        final = list(dict.fromkeys(cur + first + [x for x in after if x != pid] + [pid]))
        r = run([OC, "models", "auth", "order", "set", "--provider", prov, "--agent", agent] + final, timeout=90)
        if r.returncode != 0: print("   CHƯA đặt được thứ tự: " + (r.stderr or r.stdout).strip()[:300] + "\n   Token đã lưu; đặt tay: openclaw models auth order set --provider " + prov + " --agent " + agent + " " + " ".join(final)); return
        got = model_order(agent, prov); rc = 0 if got == final else 2
        print("   Đã lưu token và đặt thứ tự: " + " -> ".join(final) + ("  (đã đọc lại: khớp)" if rc == 0 else "  (CẢNH BÁO: đọc lại thấy: " + (", ".join(got) or "không đọc được") + ")"))
    finally:
        if was:
            r = _gw("start"); print("   Gateway " + ("đã bật lại." if r.returncode == 0 else "CHƯA bật lại được: chạy  systemctl --user start " + GW_UNIT))
    print("   Cách chạy: dùng tài khoản đầu trước; khi bị rate_limit/hết hạn mức, OpenClaw tạm bỏ tài khoản đó theo thời gian nhà cung cấp báo và dùng tài khoản kế; hết hạn thì quay lại. /new chọn lại từ đầu.")
    print("   Kiểm: openclaw models auth list --agent " + agent)
    sys.exit(rc)

def cmd_alert_test(a):
    t = current_tenant(a.tenant); tgt, tok = _alert_cfg(t)
    if not tgt: die("chưa có ID người nhận (AW_ALERT_TARGET). Chạy: kit alert-bot")
    if not tok: die("chưa có token bot báo lỗi. Chạy: kit alert-bot")
    sys.exit(0 if probe_alert(tok, tgt, interactive=False) else 1)

def cmd_init(a):
    t = a.name
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{1,30}", t): die("tên tenant: a-z 0-9 _ - (2-31 ký tự)")
    tdir(t).mkdir(parents=True, exist_ok=True); os.chmod(tdir(t), 0o700)
    save_params(t, load_params(t)); save_state(t, load_state(t))
    is_cur = set_current(t)
    if not is_cur: print(f"(tenant mặc định vẫn là '{(CFG / 'current').read_text().strip()}'; muốn chuyển sang '{t}': kit use {t}; hoặc thêm --tenant {t} vào lệnh)")
    print(f"Đã tạo tenant '{t}' tại {tdir(t)}\nBước tiếp: kit setup {t}   (hỏi từng bước có gợi ý), hoặc thủ công: kit enable base, kit enable agent-web")

def cmd_use(a):
    if not tdir(a.name).exists(): die(f"chưa có tenant '{a.name}' (có: {', '.join(sorted(p.name for p in tenants_dir().glob('*'))) or 'không'})")
    set_current(a.name, force=True); print(f"Tenant mặc định: {a.name}")

def cmd_modules(a):
    t = a.tenant or ((CFG / "current").read_text().strip() if (CFG / "current").exists() else None)
    st = load_state(t) if t else {"enabled": [], "applied": {}}
    print(f"kit {VERSION}   tenant: {t or '(chưa có)'}")
    for n in module_names():
        m = manifest(n); en = n in st["enabled"]; ap = st["applied"].get(n)
        flag = "BẬT " if en else "tắt "
        note = "" if not en else (" (chưa apply)" if not ap else (f" (có bản mới {m['version']} > đã apply {ap}: chạy 'kit apply')" if ap != m["version"] else f" đã apply v{ap}"))
        print(f"  [{flag}] {n:<12} v{m['version']:<7} {m['title']}{note}")

def cmd_enable(a):
    t = current_tenant(a.tenant); mods = with_deps([a.module])
    sets = dict(s.split("=", 1) for s in (a.set or []))
    if a.params_file:
        for k, v in json.loads(Path(a.params_file).read_text()).items(): sets.setdefault(k, str(v))
    collect_params(t, mods, sets, interactive=not a.yes and sys.stdin.isatty())
    st = load_state(t)
    for m in mods:
        if m not in st["enabled"]: st["enabled"].append(m)
    save_state(t, st); print(f"Đã bật: {', '.join(mods)}. Chạy 'kit apply --dry-run' để xem trước, 'kit apply' để dựng.")

def cmd_apply(a):
    t = current_tenant(a.tenant); st = load_state(t)
    mods = with_deps(a.module and [a.module] or st["enabled"])
    for m in mods:
        if m not in st["enabled"]: die(f"module '{m}' chưa bật (kit enable {m})")
    collect_params(t, mods, {}, interactive=False)
    ctx = context(t)
    for m in mods:
        v = apply_module(t, m, ctx, a.dry_run)
        if not a.dry_run: st["applied"][m] = v
    if not a.dry_run: save_state(t, st); print("XONG. Kiểm tra: kit doctor")

def run(cmd, **kw): return subprocess.run(cmd, capture_output=True, text=True, **kw)
def cmd_update(a):
    t = current_tenant(a.tenant)
    if (ROOT / ".git").exists():
        print("== git pull kit"); r = run(["git", "-C", str(ROOT), "pull", "--ff-only"]); print(r.stdout + r.stderr)
        if r.returncode != 0: die("git pull thất bại (có sửa tay trong kit? commit/stash rồi chạy lại)")
    if a.with_openclaw:
        print("== openclaw update"); r = subprocess.run([OC, "update", "--yes"])
        if r.returncode != 0: die("openclaw update thất bại; kit chưa apply gì thêm")
    st = load_state(t); done = set(st.get("migrations", []))
    for p in sorted((ROOT / "migrations").glob("[0-9][0-9][0-9][0-9]_*.py")):
        if p.name in done: continue
        print(f"== migration {p.name}"); r = subprocess.run([sys.executable, str(p)], env=dict(os.environ, KIT_TENANT=t, KIT_HOME=str(CFG), KIT_ROOT=str(ROOT)))
        if r.returncode != 0: die(f"migration {p.name} lỗi rc={r.returncode}")
        st["migrations"].append(p.name); save_state(t, st)
    a.module = None; a.dry_run = False; cmd_apply(a); cmd_doctor(a)

SANDBOX_IMAGE_DEFAULT = "openclaw-sandbox:trixie-slim"   # OpenClaw 2026.11.7 đòi trixie-slim (docs ghi bookworm-slim là cũ)

def oc_config():
    """Đọc ~/.openclaw/openclaw.json (JSON). Trả về dict hoặc None nếu không đọc được."""
    try: return json.loads((USER_HOME / ".openclaw" / "openclaw.json").read_text(encoding="utf-8"))
    except Exception: return None

def find_cli_runtime(o, path=""):
    """Liệt kê mọi chỗ trong cấu hình có agentRuntime.id == 'claude-cli' (runner này KHÔNG sandbox)."""
    out = []
    if isinstance(o, dict):
        for k, v in o.items():
            if k == "agentRuntime" and isinstance(v, dict) and v.get("id") == "claude-cli": out.append(path or "/")
            else: out += find_cli_runtime(v, path + "/" + str(k))
    elif isinstance(o, list):
        for i, v in enumerate(o): out += find_cli_runtime(v, path + "/" + str(i))
    return out

def sandbox_image_name(cfg):
    img = os.environ.get("KIT_SANDBOX_IMAGE")
    if img: return img
    try: return cfg["agents"]["defaults"]["sandbox"]["docker"]["image"] or SANDBOX_IMAGE_DEFAULT
    except Exception: return SANDBOX_IMAGE_DEFAULT

def sandbox_dockerfile(image):
    tag = image.split(":", 1)[1] if ":" in image else "trixie-slim"
    return f"""FROM debian:{tag}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates curl git jq python3 ripgrep && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --shell /bin/bash sandbox
USER sandbox
WORKDIR /home/sandbox
CMD ["sleep", "infinity"]
"""

def cmd_sandbox_image(a):
    if not shutil.which("docker"): die("chưa có docker; cài Docker Engine rồi: sudo usermod -aG docker $USER (đăng nhập lại)")
    img = sandbox_image_name(oc_config() or {})
    if run(["docker", "image", "inspect", img]).returncode == 0 and not a.force:
        print(f"Image {img} đã có (dùng --force để dựng lại)."); return
    print(f"== dựng {img} (khoảng 1 phút, ~300 MB)")
    r = subprocess.run(["docker", "build", "-t", img, "-"], input=sandbox_dockerfile(img), text=True)
    if r.returncode != 0: die("docker build thất bại (kiểm tra mạng/quyền docker)")
    print(f"Xong. Kiểm tra: kit doctor")

def cmd_doctor(a):
    t = current_tenant(a.tenant); bad = 0
    def chk(ok, msg, hint=""):
        nonlocal bad; print(("  OK   " if ok else "  LOI  ") + msg + ("" if ok else f"  -> {hint}")); bad += (not ok)
    print(f"kit {VERSION} / tenant {t}")
    chk(sys.version_info >= (3, 9), f"python {sys.version.split()[0]}", "cần >= 3.9")
    nv = run(["node", "-v"]).stdout.strip() if shutil.which("node") else ""
    chk(bool(nv), f"node {nv or '(thiếu)'}", "cài Node theo docs OpenClaw")
    if oc_available():
        v = run([OC, "--version"]).stdout.strip(); chk(True, f"openclaw {v}")
        r = run([OC, "config", "validate"]); chk(r.returncode == 0, "openclaw config validate", (r.stdout + r.stderr).strip()[-200:])
        for l in (r.stdout + r.stderr).splitlines():
            if l.strip().startswith("!"): print("  CANH BAO openclaw: " + l.strip().lstrip("!").strip()[:300])
    else: chk(False, "openclaw", "cài: curl -fsSL https://openclaw.ai/install.sh | bash")
    sp = tdir(t) / "secrets.env"
    if sp.exists(): chk(stat.S_IMODE(sp.stat().st_mode) == 0o600, "secrets.env chmod 600", f"chmod 600 {sp}")
    st = load_state(t)
    if "agent-web" in st["enabled"]:
        cfg = oc_config()
        if cfg is None: print("  CANH BAO không đọc được ~/.openclaw/openclaw.json (không kiểm được runtime/sandbox của model)")
        else:
            cli = find_cli_runtime(cfg)
            if cli and not os.environ.get("KIT_ALLOW_CLAUDE_CLI"):
                chk(False, "model không dùng runner claude-cli", "runner claude-cli chạy NGOÀI sandbox Docker (docs OpenClaw: Claude Code tự quản). Agent khách sẽ chạy lệnh trên máy thật. Đổi sang runtime nhúng: openclaw config set 'agents.defaults.models[\"anthropic/*\"].agentRuntime.id' openclaw (và mục model cụ thể, xem docs/MODEL-AUTH.md). Chỉ cho phép có chủ đích bằng KIT_ALLOW_CLAUDE_CLI=1. Chỗ gặp: " + ", ".join(cli[:3]))
            else: chk(True, "model không dùng runner claude-cli (agent chạy trong sandbox)" if not cli else "claude-cli được cho phép có chủ đích (KIT_ALLOW_CLAUDE_CLI=1) — agent KHÔNG được sandbox")
        ctx = context(t)
        if ctx.get("AW_GATEWAY_SSH", "local") != "local": print("  CANH BAO Gateway ở máy khác: kit không kiểm được credential model. Trên Gateway chạy: openclaw models status --agent main --check")
        elif oc_available():
            try: eff = (((cfg or {}).get("agents") or {}).get("defaults") or {}).get("authInheritance", {}).get("agentId") or "main"
            except Exception: eff = "main"
            want = (ctx.get("AW_AUTH_OWNER") or "main").strip()
            r = run([OC, "models", "status", "--agent", eff, "--check"], timeout=90)
            if r.returncode == 2: print(f"  CANH BAO token model của agent '{eff}' sắp hết hạn: dán token mới (docs/MODEL-AUTH.md)")
            else: chk(r.returncode == 0, f"credential model có ở agent '{eff}' (agent nhân viên mới thừa hưởng)", f"agent '{eff}' CHƯA có token model nên agent mới báo 'No API key found'. Dán: openclaw models auth paste-token --provider anthropic --agent {eff} --expires-in 365d (docs/MODEL-AUTH.md). Token ở agent khác: kit enable agent-web --set AW_AUTH_OWNER=<id agent> rồi kit apply agent-web")
            if want not in ("", "none") and want != eff: print(f"  CANH BAO AW_AUTH_OWNER={want} nhưng Gateway thừa hưởng từ '{eff}'. Chạy: kit run agent-web auth-owner")
        if oc_available() and ctx.get("AW_GATEWAY_SSH", "local") == "local":
            try:
                mp = model_profiles(eff)
                if mp is not None and len(mp) == 1: print("  CANH BAO model: mới có 1 tài khoản Claude (" + mp[0] + "); hết hạn mức là bot dừng. Thêm dự phòng: kit model-backup")
                elif mp: print("  OK   model: có " + str(len(mp)) + " tài khoản Claude (" + ", ".join(mp) + "); xem thứ tự: dừng Gateway rồi openclaw models auth order get --provider anthropic --agent main")
            except Exception: pass
        a_tgt, a_tok = _alert_cfg(t)
        if not a_tgt: print("  CANH BAO báo lỗi: chưa đặt ID nhận (AW_ALERT_TARGET) nên khi tạo agent lỗi chỉ ghi file log, KHÔNG có tin nhắn. Chạy: kit alert-bot")
        elif not a_tok: print("  CANH BAO báo lỗi: có ID nhận nhưng chưa có token bot gửi tin; sẽ dùng kênh Telegram của OpenClaw (nếu chưa cấu hình thì không gửi được). Chạy: kit alert-bot")
        else:
            print("  OK   báo lỗi Telegram đã cấu hình (bot + ID nhận). Thử gửi: kit alert-test")
            if oc_available():
                tgc = oc_get("channels.telegram"); tgc = tgc if isinstance(tgc, dict) else {}
                if str(tgc.get("tokenFile") or "") == str(tdir(t) / "telegram-main.token") and tgc.get("enabled", True): print("  OK   bot này đang là bot chat của agent tổng (chỉ ID nhận được nhắn)")
                else: print("  CANH BAO bot báo lỗi chưa gắn làm bot chat của agent tổng. Chạy: kit alert-bind")
        if shutil.which("docker"):
            img = sandbox_image_name(cfg or {})
            if run(["docker", "info"]).returncode == 0:
                chk(run(["docker", "image", "inspect", img]).returncode == 0, f"image sandbox {img}", "thiếu image: agent sẽ dừng với lỗi 'Sandbox image not found'. Chạy: kit sandbox-image")
        else: chk(False, "docker (agent-web chạy agent trong sandbox)", "cài Docker Engine theo docs.docker.com/engine/install/ubuntu")
    for n in st["enabled"]:
        m = manifest(n)
        if m.get("min_openclaw") and oc_available():
            pass  # so sánh phiên bản chi tiết để module tự kiểm trong 'checks'
        for c in m.get("checks", []):
            if not cond_ok(c, context(t).get): continue
            argv = [render(x, context(t), "checks") for x in c["argv"]]
            try: r = run(argv, timeout=60); ok = r.returncode == 0; out = (r.stdout + r.stderr).strip()[-160:]
            except Exception as e: ok, out = False, str(e)
            chk(ok, f"[{n}] {c['name']}", render(c["hint"], context(t), "hint") if c.get("hint") else out)
            if not ok and out and c.get("hint"): print("       " + out.replace("\n", "\n       "))
    print("Tất cả OK" if not bad else f"{bad} mục lỗi")
    if bad and getattr(a, "strict", False): sys.exit(1)   # --strict: thoát mã 1 khi có LỖI (mặc định vẫn 0 để không phá script cũ)
    return bad

def cmd_run(a):
    t = current_tenant(a.tenant); man = manifest(a.module)
    spec = man.get("commands", {}).get(a.command)
    if not spec: die(f"module {a.module} không có lệnh '{a.command}' (có: {', '.join(man.get('commands', {}))})")
    ctx = context(t); argv = [render(x, ctx, "commands") for x in spec["argv"]] + a.args
    sys.exit(subprocess.run(argv, env=dict(os.environ, KIT_TENANT=t, KIT_HOME=str(CFG), KIT_ROOT=str(ROOT))).returncode)

def cmd_export(a):
    sys.exit(subprocess.run([sys.executable, str(ROOT / "tools" / "export_config.py")] + a.args).returncode)

def main():
    os.umask(0o022)   # tránh tạo ~/.config nhóm-ghi được (umask 002 mặc định Ubuntu): OpenClaw từ chối cài service nếu thư mục cha group/world-writable
    p = argparse.ArgumentParser(prog="kit", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--tenant"); sp = p.add_subparsers(dest="cmd", required=True)
    s = sp.add_parser("setup"); s.add_argument("name", nargs="?"); s.add_argument("--modules", help="vd base,agent-web (mặc định: hỏi)"); s.add_argument("--set", action="append"); s.add_argument("--params-file"); s.add_argument("--yes", action="store_true", help="không hỏi: dùng --set/--params-file/mặc định"); s.add_argument("--no-apply", action="store_true", help="chỉ lưu + xem trước, không dựng"); s.set_defaults(f=cmd_setup)
    s = sp.add_parser("preflight"); s.set_defaults(f=cmd_preflight)
    s = sp.add_parser("init"); s.add_argument("name"); s.set_defaults(f=cmd_init)
    s = sp.add_parser("use"); s.add_argument("name"); s.set_defaults(f=cmd_use)
    s = sp.add_parser("modules"); s.set_defaults(f=cmd_modules)
    s = sp.add_parser("enable"); s.add_argument("module"); s.add_argument("--set", action="append"); s.add_argument("--params-file", help="JSON tham số KHÔNG bí mật (xem examples/)"); s.add_argument("--yes", action="store_true"); s.set_defaults(f=cmd_enable)
    s = sp.add_parser("apply"); s.add_argument("module", nargs="?"); s.add_argument("--dry-run", action="store_true"); s.set_defaults(f=cmd_apply)
    s = sp.add_parser("update"); s.add_argument("--with-openclaw", action="store_true"); s.set_defaults(f=cmd_update)
    s = sp.add_parser("doctor"); s.add_argument("--strict", action="store_true", help="thoát mã 1 nếu có mục LỖI (mặc định thoát 0)"); s.set_defaults(f=cmd_doctor)
    s = sp.add_parser("alert-bot"); s.add_argument("--no-chat", action="store_true", help="chỉ dùng bot để GỬI báo lỗi, không gắn làm bot chat của agent tổng"); s.set_defaults(f=cmd_alert_bot)
    s = sp.add_parser("alert-bind"); s.set_defaults(f=cmd_alert_bind)
    s = sp.add_parser("model-backup"); s.add_argument("--agent", help="agent nhận tài khoản (mặc định: agent tổng)"); s.add_argument("--profile-id", help="tên profile, vd anthropic:tk2 (mặc định tự chọn)"); s.set_defaults(f=cmd_model_backup)
    s = sp.add_parser("alert-test"); s.set_defaults(f=cmd_alert_test)
    s = sp.add_parser("sandbox-image"); s.add_argument("--force", action="store_true"); s.set_defaults(f=cmd_sandbox_image)
    s = sp.add_parser("run"); s.add_argument("module"); s.add_argument("command"); s.add_argument("args", nargs=argparse.REMAINDER); s.set_defaults(f=cmd_run)
    s = sp.add_parser("export-config"); s.add_argument("args", nargs=argparse.REMAINDER); s.set_defaults(f=cmd_export)
    a = p.parse_args(); a.f(a)

if __name__ == "__main__": main()
